{
  update: {
    checkOnStart: false,
  },

  telemetry: {
    enabled: false,
  },

  models: {
    catalogRefresh: {
      enabled: false,
    },
    mode: "replace",
    providers: {
      "lab-local": {
        baseUrl: "http://127.0.0.1:19006/v1",
        apiKey: "lab-local-no-secret",
        api: "openai-completions",
        timeoutSeconds: 30,
        agentRuntime: {
          id: "openclaw",
        },
        models: [
          {
            id: "policy-probe",
            name: "Lokaler deterministischer Policy-Prüfer",
            reasoning: false,
            input: ["text"],
            cost: {
              input: 0,
              output: 0,
              cacheRead: 0,
              cacheWrite: 0,
            },
            contextWindow: 16384,
            maxTokens: 1024,
            compat: {
              supportsTools: true,
              supportsStrictMode: false,
              supportsUsageInStreaming: false,
            },
          },
        ],
      },
    },
  },

  gateway: {
    mode: "local",
    bind: "loopback",
    port: 19005,
    controlUi: {
      enabled: false,
      basePath: "/openclaw-lab",
    },
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },

  agents: {
    ownership: "explicit",
    defaults: {
      skills: [],
      model: {
        primary: "lab-local/policy-probe",
      },
      utilityModel: "",
      heartbeat: {
        every: "0m",
        target: "none",
      },
      sandbox: {
        mode: "all",
        backend: "docker",
        scope: "session",
        workspaceAccess: "none",
        docker: {
          image: "openclaw-sandbox:bookworm-slim",
          readOnlyRoot: true,
          tmpfs: ["/tmp", "/var/tmp", "/run"],
          network: "none",
          capDrop: ["ALL"],
        },
      },
    },
    entries: {
      "sol-holo-lab": {
        name: "Sol Holo OpenClaw Lab",
        workspace: "${OPENCLAW_LAB_ROOT}/workspace",
        agentDir: "${OPENCLAW_LAB_STATE_DIR}/agents/sol-holo-lab",
        tools: {
          deny: ["*"],
        },
      },
      "worker-alltag": {
        name: "Worker Alltag",
        workspace: "${OPENCLAW_LAB_ROOT}/workspaces/alltag",
        agentDir: "${OPENCLAW_LAB_STATE_DIR}/agents/worker-alltag",
        sandbox: {
          workspaceAccess: "ro",
        },
        tools: {
          allow: ["read"],
        },
      },
      "worker-geschaeftliches": {
        name: "Worker Geschäftliches",
        workspace: "${OPENCLAW_LAB_ROOT}/workspaces/geschaeftliches",
        agentDir: "${OPENCLAW_LAB_STATE_DIR}/agents/worker-geschaeftliches",
        sandbox: {
          workspaceAccess: "ro",
        },
        tools: {
          allow: ["read"],
        },
      },
      "worker-tiere": {
        name: "Worker Tiere",
        workspace: "${OPENCLAW_LAB_ROOT}/workspaces/tiere",
        agentDir: "${OPENCLAW_LAB_STATE_DIR}/agents/worker-tiere",
        sandbox: {
          workspaceAccess: "ro",
        },
        tools: {
          allow: ["read"],
        },
      },
      "worker-kochen": {
        name: "Worker Kochen",
        workspace: "${OPENCLAW_LAB_ROOT}/workspaces/kochen",
        agentDir: "${OPENCLAW_LAB_STATE_DIR}/agents/worker-kochen",
        sandbox: {
          workspaceAccess: "ro",
        },
        tools: {
          allow: ["read"],
        },
      },
    },
  },

  tools: {
    profile: "coding",
    allow: ["read"],
    deny: [
      "write",
      "edit",
      "apply_patch",
      "group:runtime",
      "group:web",
      "group:messaging",
      "group:sessions",
      "group:memory",
      "group:automation",
      "browser",
      "canvas",
      "image",
      "view_image",
      "image_generate",
      "music_generate",
      "video_generate",
    ],
    fs: {
      workspaceOnly: true,
    },
    sandbox: {
      tools: {
        allow: ["read"],
        deny: ["view_image"],
      },
    },
    exec: {
      security: "deny",
      ask: "always",
    },
    elevated: {
      enabled: false,
    },
    sessions: {
      visibility: "self",
    },
    agentToAgent: {
      enabled: false,
    },
  },

  plugins: {
    enabled: false,
  },

  skills: {
    allowBundled: [],
    workshop: {
      autonomous: {
        mode: "off",
      },
      approvalPolicy: "pending",
    },
  },
}
